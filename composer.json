{
    "name": "farzai/geonames",
    "type": "library",
    "description": "GeoNames countries, administrative divisions, cities and postal codes from verified Farzai snapshots. Plain PHP, with first-class Laravel support.",
    "keywords": [
        "geonames",
        "countries",
        "cities",
        "postal-code",
        "geocoding",
        "iso-3166",
        "laravel",
        "validation"
    ],
    "homepage": "https://github.com/farzai/geonames-php",
    "license": "MIT",
    "authors": [
        {
            "name": "parsilver",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-json": "*",
        "ext-zlib": "*",
        "illuminate/collections": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.2",
        "orchestra/testbench": "^10.0 || ^11.0",
        "pestphp/pest": "^3.0 || ^4.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "ext-pdo_sqlite": "Reads the per-country SQLite files (nearest-city lookups).",
        "laravel/framework": "Service provider, facade, validation rules, Eloquent casts, migrations and seeder are discovered automatically"
    },
    "bin": [
        "bin/geonames"
    ],
    "autoload": {
        "psr-4": {
            "Farzai\\Geonames\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Farzai\\Geonames\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint",
        "analyse": "vendor/bin/phpstan analyse"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
